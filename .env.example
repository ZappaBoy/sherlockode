# Model provider credentials used by PydanticAI (and by the claude-code/codex CLI backends, which read the
# same variables themselves).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local/self-hosted OpenAI-compatible LLM (Ollama, vLLM, LM Studio, llama.cpp server, LiteLLM) for the
# pydantic-ai backend: set REPO_AGENT_AGENT__BASE_URL to the server's URL and, if it requires a key,
# REPO_AGENT_AGENT__API_KEY_ENV to the name of the variable below that holds it.
# REPO_AGENT_AGENT__BASE_URL=http://localhost:11434/v1
# REPO_AGENT_AGENT__API_KEY_ENV=LOCAL_LLM_API_KEY
# LOCAL_LLM_API_KEY=not-needed

# Git provider tokens: REPO_AGENT_<PROVIDER NAME>_TOKEN, or REPO_AGENT_PROVIDERS__<NAME>__TOKEN.
REPO_AGENT_GITHUB_TOKEN=
REPO_AGENT_GITLAB_TOKEN=

# Any setting can be overridden; nested keys use "__".
REPO_AGENT_WORKSPACE=./workspace
REPO_AGENT_LOG_LEVEL=INFO
REPO_AGENT_SANDBOX__ENABLED=true
REPO_AGENT_AGENT__MODEL=anthropic:claude-opus-5-5
# REPO_AGENT_AGENT__BACKEND=claude-code   # or "codex"; both skip the planner and run read-only

# Docker build: set to "true" to install the Claude Code and Codex CLIs into the application image
# (required for REPO_AGENT_AGENT__BACKEND=claude-code / codex). See docker compose --profile build build.
# INSTALL_AGENT_CLIS=false

# Host docker group id, used by compose.yaml (group_add) so the container can reach /var/run/docker.sock.
# DOCKER_GID=
