# Model provider credentials used by PydanticAI.
ANTHROPIC_API_KEY=

# Git provider tokens: REPO_AGENT_<PROVIDER NAME>_TOKEN, or REPO_AGENT_PROVIDERS__<NAME>__TOKEN.
REPO_AGENT_GITHUB_TOKEN=
REPO_AGENT_GITLAB_TOKEN=

# Any setting can be overridden; nested keys use "__".
REPO_AGENT_WORKSPACE=./workspace
REPO_AGENT_LOG_LEVEL=INFO
REPO_AGENT_SANDBOX__ENABLED=true
REPO_AGENT_AGENT__MODEL=anthropic:claude-opus-5-5
